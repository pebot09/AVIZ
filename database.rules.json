{
  "rules": {
    "tenantsPublic": {
      ".read": true,
      "$tid": {
        ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid + '/role').val() == 'owner'"
      }
    },
    "tenants": {
      "$tid": {
        ".read": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid).exists()",
        "config": {
          ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid + '/role').val() == 'owner'"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ( root.child('tenants/' + $tid + '/members/' + auth.uid + '/role').val() == 'owner' || ($uid == auth.uid && !root.child('tenants/' + $tid + '/members').exists() && newData.child('role').val() == 'owner') )"
          }
        },
        "state": {
          ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid).exists()"
        },
        "snapshots": {
          ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid).exists()"
        }
      }
    },
    "billing": {
      ".read": false,
      ".write": false
    }
  }
}
