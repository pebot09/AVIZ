{
  "rules": {
    "tenantsPublic": {
      ".read": true,
      "$tid": { ".write": false }
    },
    "tenants": {
      "$tid": {
        ".read": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid).exists()",
        "config": {
          ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid + '/role').val() == 'owner'"
        },
        "members": {
          ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid + '/role').val() == 'owner'"
        },
        "state": {
          ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid).exists()"
        },
        "snapshots": {
          ".write": "auth != null && root.child('tenants/' + $tid + '/members/' + auth.uid).exists()"
        }
      }
    },
    "billing": {
      ".read": false,
      ".write": false
    }
  }
}
