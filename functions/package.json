{
  "name": "aviz-functions",
  "version": "1.0.0",
  "type": "module",
  "description": "Fatia do aluno — o servidor que valida o código de acesso e serve só os dados daquele aluno.",
  "main": "lib/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --log-level=error",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0"
  },
  "private": true
}
